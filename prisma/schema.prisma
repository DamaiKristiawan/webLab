generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolStaff {
  ADMIN
  ASISTEN
}

enum JabatanLab {
  KEPALA_LAB
  DOSEN
  PLP
  ASISTEN
}

enum JenisJadwal {
  PRAKTIKUM
  SEMINAR
  LAINNYA
}

enum JenisPengajuan {
  ALAT
  RUANGAN
  PENELITIAN
}

enum StatusPengajuan {
  MENUNGGU
  DISETUJUI
  DITOLAK
  SELESAI
  DIBATALKAN
}

enum JenisTes {
  PRETEST
  POSTEST
}

enum TipePertanyaan {
  SKALA
  TEKS
}

model Staff {
  id           Int         @id @default(autoincrement())
  nama         String
  username     String      @unique
  email        String?
  passwordHash String
  rol          RolStaff    @default(ASISTEN)
  aktif        Boolean     @default(true)
  createdAt    DateTime    @default(now())
  pengajuan    Pengajuan[]
  anggota      AnggotaLab?
}

model AnggotaLab {
  id       Int        @id @default(autoincrement())
  nama     String
  jabatan  JabatanLab
  label    String?
  angkatan Int?
  nipNpm   String?
  email    String?
  kontak   String?
  bidang   String?
  fotoUrl  String?
  urutan   Int        @default(0)
  aktif    Boolean    @default(true)
  staffId  Int?       @unique
  staff    Staff?     @relation(fields: [staffId], references: [id], onDelete: SetNull)
}

model Pengaturan {
  id    Int    @id @default(autoincrement())
  kunci String @unique
  nilai String @db.Text
}

model Pengumuman {
  id            Int       @id @default(autoincrement())
  judul         String
  isi           String    @db.Text
  mulaiTampil   DateTime  @default(now())
  selesaiTampil DateTime?
  aktif         Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model Ruangan {
  id        Int         @id @default(autoincrement())
  nama      String
  kapasitas Int?
  deskripsi String?
  aktif     Boolean     @default(true)
  jadwal    Jadwal[]
  pengajuan Pengajuan[]
}

model Alat {
  id        Int             @id @default(autoincrement())
  nama      String
  kategori  String?
  stokTotal Int             @default(1)
  kondisi   String?         @default("Baik")
  deskripsi String?
  fotoUrl   String?
  aktif     Boolean         @default(true)
  dipinjam  PengajuanAlat[]
}

model Jadwal {
  id          Int         @id @default(autoincrement())
  judul       String
  jenis       JenisJadwal @default(PRAKTIKUM)
  mulai       DateTime
  selesai     DateTime
  ruanganId   Int?
  ruangan     Ruangan?    @relation(fields: [ruanganId], references: [id])
  praktikumId Int?
  praktikum   Praktikum?  @relation(fields: [praktikumId], references: [id])
  kelas       String?
  pengampu    String?
  keterangan  String?
  pengajuanId Int?        @unique
  pengajuan   Pengajuan?  @relation(fields: [pengajuanId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@index([mulai])
}

model Pengajuan {
  id              Int             @id @default(autoincrement())
  kode            String          @unique
  jenis           JenisPengajuan
  status          StatusPengajuan @default(MENUNGGU)

  namaLengkap     String
  npm             String
  programStudi    String
  email           String
  noHp            String

  keperluan       String          @db.Text
  keterangan      String?         @db.Text
  tanggalMulai    DateTime
  tanggalSelesai  DateTime

  ruanganId       Int?
  ruangan         Ruangan?        @relation(fields: [ruanganId], references: [id])

  judulPenelitian String?
  dosenPembimbing String?
  abstrak         String?         @db.Text

  buktiUrl        String?
  buktiLink       String?

  alat            PengajuanAlat[]

  jadwal          Jadwal?

  catatanAdmin    String?         @db.Text
  diprosesOlehId  Int?
  diprosesOleh    Staff?          @relation(fields: [diprosesOlehId], references: [id])
  diprosesPada    DateTime?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([jenis])
  @@index([tanggalMulai])
}

model PengajuanAlat {
  id          Int       @id @default(autoincrement())
  pengajuanId Int
  pengajuan   Pengajuan @relation(fields: [pengajuanId], references: [id], onDelete: Cascade)
  alatId      Int
  alat        Alat      @relation(fields: [alatId], references: [id])
  jumlah      Int       @default(1)

  @@unique([pengajuanId, alatId])
}

model Praktikum {
  id          Int              @id @default(autoincrement())
  nama        String
  slug        String           @unique
  deskripsi   String?          @db.Text
  modulUrl    String?
  aktif       Boolean          @default(true)
  daftarJudul JudulPraktikum[]
  jadwal      Jadwal[]
}

model JudulPraktikum {
  id          Int       @id @default(autoincrement())
  praktikumId Int
  praktikum   Praktikum @relation(fields: [praktikumId], references: [id], onDelete: Cascade)
  urutan      Int
  judul       String
  tes         Tes[]

  @@unique([praktikumId, urutan])
}

model Tes {
  id             Int            @id @default(autoincrement())
  judulId        Int
  judulPraktikum JudulPraktikum @relation(fields: [judulId], references: [id], onDelete: Cascade)
  jenis          JenisTes
  durasiMenit    Int            @default(30)
  aktif          Boolean        @default(true)
  kodeAkses      String?
  soal           Soal[]
  hasil          HasilTes[]
  sesi           SesiTes[]

  @@unique([judulId, jenis])
}

model Soal {
  id           Int    @id @default(autoincrement())
  tesId        Int
  tes          Tes    @relation(fields: [tesId], references: [id], onDelete: Cascade)
  pertanyaan   String @db.Text
  opsi         Json
  jawabanBenar Int
  urutan       Int    @default(0)
}

model SesiTes {
  id          Int      @id @default(autoincrement())
  tesId       Int
  tes         Tes      @relation(fields: [tesId], references: [id], onDelete: Cascade)
  npm         String
  namaPeserta String
  mulaiPada   DateTime @default(now())
  batasPada   DateTime
  selesai     Boolean  @default(false)

  @@unique([tesId, npm])
}

model HasilTes {
  id          Int      @id @default(autoincrement())
  tesId       Int
  tes         Tes      @relation(fields: [tesId], references: [id], onDelete: Cascade)
  namaPeserta String
  npm         String
  skor        Float
  jumlahBenar Int
  jumlahSoal  Int
  jawaban     Json
  terlambat   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([tesId, npm])
}

model Survei {
  id         Int                @id @default(autoincrement())
  kode       String             @default("umum")   // jenis kuesioner: kepuasan-pengguna, pengguna, praktikum, penelitian
  tahun      Int                @default(2026)     // periode
  judul      String
  deskripsi  String?
  aktif      Boolean            @default(true)
  pertanyaan PertanyaanSurvei[]
  respon     ResponSurvei[]
  createdAt  DateTime           @default(now())

  @@unique([kode, tahun])
}

model PertanyaanSurvei {
  id        Int              @id @default(autoincrement())
  surveiId  Int
  survei    Survei           @relation(fields: [surveiId], references: [id], onDelete: Cascade)
  teks      String
  tipe      TipePertanyaan   @default(SKALA)
  kelompok  String?          // nama dimensi, mis. "Empati"
  urutan    Int              @default(0)
  jawaban   JawabanSurvei[]
}

// Menyimpan nama dan NPM (hanya admin yang melihat). Satu NPM satu kali per kuesioner/periode.
// Kolom dibuat nullable agar respon anonim lama tetap valid.
model ResponSurvei {
  id          Int             @id @default(autoincrement())
  surveiId    Int
  survei      Survei          @relation(fields: [surveiId], references: [id], onDelete: Cascade)
  namaPeserta String?
  npm         String?
  createdAt   DateTime        @default(now())
  jawaban     JawabanSurvei[]

  @@unique([surveiId, npm])
}

model JawabanSurvei {
  id           Int              @id @default(autoincrement())
  responId     Int
  respon       ResponSurvei     @relation(fields: [responId], references: [id], onDelete: Cascade)
  pertanyaanId Int
  pertanyaan   PertanyaanSurvei @relation(fields: [pertanyaanId], references: [id], onDelete: Cascade)
  nilai        Int?
  teks         String?          @db.Text
}

model Dokumentasi {
  id        Int               @id @default(autoincrement())
  judul     String
  slug      String            @unique
  ringkasan String?
  isi       String?           @db.Text
  coverUrl  String?
  tanggal   DateTime          @default(now())
  terbit    Boolean           @default(true)
  foto      DokumentasiFoto[]
  createdAt DateTime          @default(now())
}

model DokumentasiFoto {
  id            Int         @id @default(autoincrement())
  dokumentasiId Int
  dokumentasi   Dokumentasi @relation(fields: [dokumentasiId], references: [id], onDelete: Cascade)
  url           String
  caption       String?
  urutan        Int         @default(0)
}
